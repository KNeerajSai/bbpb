# Boston Bioprocess Fermentation Data Platform Environment Configuration

# Application Settings
BBPF_APP_NAME=Boston Bioprocess Fermentation Data Platform
BBPF_APP_VERSION=1.0.0
BBPF_DEBUG=false
BBPF_LOG_LEVEL=INFO

# Server Configuration  
BBPF_HOST=0.0.0.0
BBPF_PORT=8000

# Database Configuration
BBPF_DATABASE_URL=postgresql://postgres:password@localhost:5432/fermentation_db
BBPF_DATABASE_POOL_SIZE=10
BBPF_DATABASE_MAX_OVERFLOW=20
BBPF_DATABASE_POOL_PRE_PING=true
BBPF_DATABASE_POOL_RECYCLE=300

# File Upload Configuration
BBPF_UPLOAD_DIR=./uploads
BBPF_MAX_FILE_SIZE=10485760

# CORS Configuration
BBPF_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
BBPF_CORS_ALLOW_CREDENTIALS=true

# Performance Settings
BBPF_ENABLE_GZIP=true
BBPF_GZIP_MINIMUM_SIZE=1000

# Monitoring
BBPF_ENABLE_METRICS=true
BBPF_METRICS_ENDPOINT=/metrics